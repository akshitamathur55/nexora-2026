<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>NEXORA 2026 — Payment</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container" style="max-width: 560px; padding-top: 48px;">
    <h1>Payment</h1>
    <div class="card" id="payment-section" style="display:none; margin-bottom:24px;">
      <h3>Scan & Pay ₹100</h3>
      <img src="/images/payment-qr.png" alt="UPI payment QR code" style="max-width:240px; display:block; margin-bottom:16px;">
      <label for="proof-file">Upload Payment Screenshot *</label>
      <input type="file" id="proof-file" accept="image/jpeg,image/png" style="margin-bottom:16px;">
      <div id="upload-error" style="color: var(--status-error); margin-bottom:16px;"></div>
      <button id="upload-btn" class="btn btn-primary">Upload & Finish</button>
    </div>
    <div class="card" id="status-section" style="display:none;">
      <h3>Payment Status</h3>
      <span id="status-tag" class="status-tag"></span>
      <p style="margin-top:12px;"><a href="/dashboard">Go to Dashboard →</a></p>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/nav.js"></script>
  <script src="/js/payment.js"></script>
</body>
</html>