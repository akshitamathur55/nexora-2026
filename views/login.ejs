<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>NEXORA 2026 — Log In</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container" style="max-width: 480px; padding-top: 48px;">
    <h1>Log in</h1>
    <form id="login-form" class="card">
      <div id="error-box" style="color: var(--status-error); margin-bottom: 16px;"></div>

      <label for="email">Email *</label>
      <input type="email" id="email" required style="width:100%; margin-bottom:16px; padding:8px;">

      <label for="password">Password *</label>
      <input type="password" id="password" required style="width:100%; margin-bottom:24px; padding:8px;">

      <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%;">Log In</button>
      <p style="margin-top:16px;">Don't have an account? <a href="/signup">Sign Up</a></p>
    </form>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/login.js"></script>
  <script src="/js/nav.js"></script>
</body>
</html>