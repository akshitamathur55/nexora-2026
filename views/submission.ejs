<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>NEXORA 2026 — Submission</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container" style="max-width: 640px; padding-top: 48px;">
    <h1>Abstract & Poster Submission</h1>
    <p style="color: var(--status-pending); margin-bottom: 24px;">Submissions close 30 Sept, 11:59 PM.</p>

      <form id="submission-form">
      <label for="title">Title *</label>
      <input type="text" id="title" style="margin-bottom:16px;">
      <label for="authors">Authors *</label>
      <input type="text" id="authors" style="margin-bottom:16px;">
      <label for="track">Track *</label>
      <select id="track" style="margin-bottom:16px;">
        <option value="">Select a track</option>
        <option>AI/ML</option><option>Data Science</option><option>Emerging Tech</option>
        <option>Sustainable Tech</option><option>Interdisciplinary Innovation</option>
      </select>

      <label for="abstract">Abstract (approximately 150 words) *</label>
      <textarea id="abstract" style="margin-bottom:16px; min-height:140px;"></textarea>

      <label for="keywords">Keywords *</label>
      <input type="text" id="keywords" style="margin-bottom:16px;">

      <label for="abstractFile">Abstract PDF *</label>
      <input type="file" id="abstractFile" accept="application/pdf" style="margin-bottom:16px;">

      <label for="poster">Poster (PDF, PNG, or JPG/JPEG, max 10MB) *</label>
      <input type="file" id="poster" accept="application/pdf,image/png,image/jpeg" style="margin-bottom:16px;">

      <div id="submission-error" style="color: var(--status-error); margin-bottom: 16px;"></div>
      <button type="submit" id="submission-submit-btn" class="btn btn-primary" style="width:100%;">Continue to Payment →</button>
    </form>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/nav.js"></script>
  <script src="/js/submission.js"></script>
</body>
</html>