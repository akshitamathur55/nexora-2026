<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>NEXORA 2026 — Sign Up</title>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container" style="max-width: 480px; padding-top: 48px;">
    <h1>Create your account</h1>
    <form id="signup-form" class="card">
      <div id="error-box" style="color: var(--status-error); margin-bottom: 16px;"></div>

      <label for="name">Full Name *</label>
      <input type="text" id="name" required style="width:100%; margin-bottom:16px; padding:8px;">

      <label for="email">Email *</label>
      <input type="email" id="email" required style="width:100%; margin-bottom:16px; padding:8px;">

      <label for="password">Password *</label>
      <input type="password" id="password" required minlength="6" style="width:100%; margin-bottom:16px; padding:8px;">

      <label for="confirmPassword">Confirm Password *</label>
      <input type="password" id="confirmPassword" required minlength="6" style="width:100%; margin-bottom:16px; padding:8px;">

      <label for="college">College *</label>
      <input type="text" id="college" required style="width:100%; margin-bottom:16px; padding:8px;">

      <label for="phone">Phone *</label>
      <input type="tel" id="phone" required style="width:100%; margin-bottom:24px; padding:8px;">

      <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%;">Sign Up</button>
      <p style="margin-top:16px;">Already have an account? <a href="/login">Log In</a></p>
    </form>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/signup.js"></script>
  <script src="/js/nav.js"></script>
</body>
</html>