  <!-- ============ OUR LEADERSHIP ============ -->
  <div class="container">
    <p class="eyebrow">Our Leadership</p>
    <h2>The People Behind <span class="heading-accent">NEXORA 2026</span></h2>
    <div class="leader-grid">
      <%
        const leaders = [
          { name: 'Shri P.K. Gupta', role: 'Chairman', photo: '/images/leaders/pkgupta.jpg' },
          { name: 'Shri Y.K. Gupta', role: 'Vice Chairman', photo: '/images/leaders/ykgupta.jpg' },
          { name: 'Prof. Vinod Kumar Sharma', role: 'Executive Vice President', photo: '/images/leaders/vksharma.jpg' },
          { name: 'Dr. R.S. Pavithra', role: 'Director', photo: '/images/leaders/drrspavitra.jpeg' },
          { name: 'Prof. M.S. Gaur', role: 'Dean R&D', photo: '/images/leaders/gaursir.png' },
          { name: 'Dr. Shankar Thawkar', role: 'Head Of Department, CSE',  photo: '/images/leaders/Shankarsirhod.png' },
          { name: 'Mrs. Deepti Mittal', role: 'Head Of Department, IT', photo: '/images/leaders/Deeptimam.png' },
          { name: 'Mr. Gaurav Pandey', role: 'Faculty Coordinator',  photo: '/images/leaders/gauravsir.jpeg' },
          { name: 'Mr. Utkarsh Gupta', role: 'Faculty Coordinator',  photo: '/images/leaders/utkarshsir.jpeg' },
         ];
      %>
      <% leaders.forEach(function(leader) {
        const initials = leader.name.replace(/^(Shri|Dr\.|Prof\.|Mr\.|Mrs\.)\s/, '').split(' ').map(w => w[0]).slice(0,2).join('');
      %>
        <div class="leader-card">
          <div class="leader-photo-wrap">
            <div class="leader-photo" data-photo="<%= leader.photo || '' %>">
              <span class="leader-initials"><%= initials %></span>
            </div>
          </div>
          <div class="leader-info">
            <h3 class="leader-name"><%= leader.name %></h3>
            <p class="leader-role"><%= leader.role %></p>
            <p class="leader-qualification"><%= leader.qualification %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/nav.js"></script>
  <script src="/js/leader-photos.js"></script>
  <script src="/js/timeline-align.js"></script>
</body>
</html>